Bundle-Name: Filter-DevKit Circuit Loop Plugin
Bundle-Description: API Gateway implementation for Circuit Loop
Bundle-Vendor: Axway
Bundle-DocURL: https://github.com/Axway-API-Management-Plus/filter-devkit
Bundle-ClassPath: .
Require-Bundle: \
	com.vordel.rcp.filterbase
Export-Package: com.vordel.client.manager.filter.devkit.loop
Import-Package: \
	com.vordel.client.manager,\
	com.vordel.client.manager.attr,\
	com.vordel.client.manager.commands,\
	com.vordel.client.manager.table,\
	com.vordel.client.manager.ui,\
	com.vordel.client.manager.util,\
	com.vordel.client.manager.wizard,\
	com.vordel.client.ui.declarative,\
	com.vordel.client.swt,\
	com.vordel.el,\
	com.vordel.es,\
	com.vordel.trace,\
	org.eclipse.jface.viewers,\
	org.eclipse.jface.window,\
	org.eclipse.osgi.util,\
	org.eclipse.swt,\
	org.eclipse.swt.custom,\
	org.eclipse.swt.events,\
	org.eclipse.swt.graphics,\
	org.eclipse.swt.layout,\
	org.eclipse.swt.widgets,\
	com.vordel.circuit.filter.devkit.quick.annotations,\
	com.vordel.circuit.filter.devkit.context.annotations,\
	com.vordel.client.manager.filter.devkit.studio,\
	com.vordel.client.manager.filter.devkit.studio.quick,\
	com.vordel.client.manager.filter.devkit.runtime,\
	*;'resolution:'=optional

-noee=true
